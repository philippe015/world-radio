<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#2B2B2B" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <gradient android:angle="270" android:startColor="#C8C8C8" android:centerColor="#ADADAD" android:endColor="#8E8E8E" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <gradient android:angle="270" android:startColor="#E4E4E4" android:centerColor="#C9C9C9" android:endColor="#A6A6A6" />
            <stroke android:width="1dp" android:color="#6F6F6F" />
        </shape>
    </item>
</layer-list>
