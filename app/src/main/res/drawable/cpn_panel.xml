<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><solid android:color="#00F0FF" /><corners android:radius="4dp" /></shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape><solid android:color="#FF2E88" /><corners android:radius="3dp" /></shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <gradient android:angle="270" android:startColor="#150A28" android:centerColor="#0B0518" android:endColor="#05010F" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
