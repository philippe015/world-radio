<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape><solid android:color="#FFFFFF" /><corners android:radius="3dp" /></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape><gradient android:angle="270" android:startColor="#00B85C" android:endColor="#006B36" /><corners android:radius="2dp" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#00FF88" /><corners android:radius="3dp" /></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape><gradient android:angle="270" android:startColor="#5CFF9E" android:centerColor="#00E676" android:endColor="#009E4F" /><corners android:radius="2dp" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
