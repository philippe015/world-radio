<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="270" android:startColor="#0B1220" android:endColor="#1B2A44" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#22D3EE" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#1E293B" android:centerColor="#16202F" android:endColor="#0B1220" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#334155" />
        </shape>
    </item>
</selector>
