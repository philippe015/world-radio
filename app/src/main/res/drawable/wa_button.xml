<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape><solid android:color="#3A3A3A" /><corners android:radius="2dp" /></shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape>
                    <gradient android:angle="270" android:startColor="#7D7D7D" android:endColor="#AFAFAF" />
                    <stroke android:width="1dp" android:color="#5F5F5F" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape><solid android:color="#3A3A3A" /><corners android:radius="2dp" /></shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape>
                    <gradient android:angle="270" android:startColor="#E6E6E6" android:centerColor="#C4C4C4" android:endColor="#969696" />
                    <stroke android:width="1dp" android:color="#7A7A7A" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
