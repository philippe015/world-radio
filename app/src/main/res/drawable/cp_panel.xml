<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#00FF66" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <solid android:color="#020604" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <gradient android:angle="270" android:startColor="#13241C" android:centerColor="#0B1511" android:endColor="#050A08" />
            <stroke android:width="1dp" android:color="#0E3D28" />
        </shape>
    </item>
</layer-list>
