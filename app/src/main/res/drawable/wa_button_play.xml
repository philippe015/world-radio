<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape><solid android:color="#3A3A3A" /><corners android:radius="2dp" /></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape><gradient android:angle="270" android:startColor="#1F4A22" android:endColor="#2E6B33" /><stroke android:width="1dp" android:color="#12300F" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#3A3A3A" /><corners android:radius="2dp" /></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape><gradient android:angle="270" android:startColor="#8CE68C" android:endColor="#3FA046" /><stroke android:width="1dp" android:color="#2C7A33" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
