<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="270" android:startColor="#0891B2" android:endColor="#155E75" />
            <corners android:radius="40dp" />
            <stroke android:width="1dp" android:color="#67E8F9" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#22D3EE" android:centerColor="#0EA5E9" android:endColor="#0369A1" />
            <corners android:radius="40dp" />
            <stroke android:width="1dp" android:color="#A5F3FC" />
        </shape>
    </item>
</selector>
